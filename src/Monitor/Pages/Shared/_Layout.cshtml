<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - m0nit0r</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body { background: #0d1117; color: #c9d1d9; }
        .navbar { background: #161b22 !important; border-bottom: 1px solid #30363d; }
        .card { background: #161b22; border: 1px solid #30363d; }
        .card-header { background: #1c2128; border-bottom: 1px solid #30363d; }
        .table { color: #c9d1d9; }
        .table-dark { --bs-table-bg: #161b22; --bs-table-border-color: #30363d; }
        .badge-online { background: #2ea043; }
        .badge-offline { background: #da3633; }
        .status-dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
        .dot-online { background: #2ea043; box-shadow: 0 0 6px #2ea043; }
        .dot-offline { background: #da3633; }
        .dot-unknown { background: #6e7681; }
        .metric-value { font-size: 1.5rem; font-weight: 600; }
        .progress { background: #30363d; height: 6px; }
        .server-card { cursor: pointer; transition: border-color 0.2s; }
        .server-card:hover, .server-card.active { border-color: #58a6ff !important; }
        .avail-cell { min-width: 90px; text-align: center; font-size: 0.85rem; }
        .avail-up { background: rgba(46, 160, 67, 0.2); color: #3fb950; }
        .avail-down { background: rgba(218, 54, 51, 0.2); color: #f85149; }
        .avail-unknown { background: rgba(110, 118, 129, 0.15); color: #6e7681; }
        .chart-container { position: relative; height: 200px; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark mb-4">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" href="/">
                <i class="bi bi-activity text-success me-1"></i>m0nit0r
            </a>
            <span class="text-muted small ms-3" id="nav-self-info"></span>
            <div class="ms-auto">
                <span class="text-muted small" id="nav-last-update"></span>
            </div>
        </div>
    </nav>
    <div class="container-fluid px-4">
        @RenderBody()
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
