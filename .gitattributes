# Vendored dashboard assets are embedded and served byte for byte. Line ending
# normalisation would make those bytes, and the ETags derived from them, differ
# depending on which platform checked the repository out.
internal/web/assets/** -text

# The installer is fetched and run on Linux nodes; /bin/sh will not run a
# script with CRLF line endings, whatever the platform it was checked out on.
*.sh text eol=lf
